---
const { title, subtitle, date, items = [], children } = Astro.props;
---

<div class="border-primary relative border-l-2 pl-6">
  <div
    class="bg-primary absolute top-2 -left-[7px] h-3 w-3 rounded-full"
  >
  </div>
  <h2 class="text-2xl font-bold">{title}</h2>
  {subtitle && (
    <h3 class="text-muted-foreground text-lg">{subtitle}</h3>
  )}
  <p class="text-muted-foreground text-sm">{date}</p>
  {items && items.length > 0 && (
    <ul class="mt-2 list-disc space-y-2 pl-5 text-sm md:text-base">
      {items.map((item, index) => (
        <li key={index}>{item}</li>
      ))}
    </ul>
  )}
  {children}
</div>
