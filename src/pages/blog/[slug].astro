---
import BaseLayout from "@/layouts/base.astro";
import { getCollection, render } from "astro:content";
import BlogPostHeader from "@/components/blog-post-header.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
  <article
    class="prose dark:prose-invert prose-headings:font-extrabold prose-sm sm:prose-base mx-auto max-w-none px-4 py-6 pb-16 sm:max-w-3xl sm:px-6 sm:py-8 lg:px-8"
  >
    <BlogPostHeader post={post} />

    <div class="prose-content">
      <Content />
    </div>
  </article>
</BaseLayout>
