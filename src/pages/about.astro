---
import BaseLayout from "@/layouts/base.astro";
import CenterLayout from "@/layouts/center.astro";

const animation =
  "animate-in fade-in duration-1000 ease-out fill-mode-backwards slide-in-from-left-12";
---

<BaseLayout
  title="about"
  description="About Ceferino Patino: background, education, skills, and experience."
  canonical="https://cpatino.com/about"
>
  <CenterLayout>
    <div
      class="flex w-full max-w-3xl flex-col items-center gap-8 px-4 py-8 md:px-0"
    >
      <h1 class={`${animation} tracking-light text-4xl font-extrabold`}>
        about me
      </h1>

      <div
        class={`${animation} delay-100 text-sm font-medium md:text-lg text-center`}
      >
        Software engineer with hands-on experience building enterprise
        applications at Mutual of Omaha — developing RESTful APIs and backend
        services in Java and Groovy, building Angular and TypeScript front ends,
        and owning Python deployment orchestration and CI pipelines. Pairs
        production delivery with research-grade systems work, including a
        Rust+CUDA backend that doubled the performance of an international
        multi-agent reinforcement learning benchmark. Seeking full-time roles
        focused on full-stack development and developer tooling.
      </div>

      <section class={`${animation} delay-200 w-full`}>
        <h2 class="mb-4 text-2xl font-bold">Quick Facts</h2>
        <ul
          class="flex list-inside list-disc flex-col gap-3 text-sm font-medium md:text-lg"
        >
          <li class="delay-100">19 y/o systems and AI enthusiast</li>
          <li class="delay-100">devoted nixos user & contributor</li>
          <li class="delay-100">neovim & terminal life—always</li>
          <li class="delay-100">love open systems and dev tools</li>
          <li class="delay-100">building fast things with Rust</li>
        </ul>
      </section>

      <section class={`${animation} delay-300 w-full`}>
        <h2 class="mb-4 text-2xl font-bold">Education</h2>
        <div class="mb-4">
          <h3 class="text-xl font-semibold">
            University of Nebraska — Lincoln
          </h3>
          <p class="text-sm md:text-base">B.S. Computer Science (2024-2026)</p>
        </div>
        <div>
          <h3 class="text-xl font-semibold">St. Louis Community College</h3>
          <p class="text-sm md:text-base">Transfer (2022-2024)</p>
        </div>
      </section>

      <section class={`${animation} delay-400 w-full`}>
        <h2 class="mb-4 text-2xl font-bold">Skills</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <h3 class="text-lg font-semibold">Languages</h3>
            <p>
              Python, C++, Rust, JavaScript, TypeScript, Groovy, Lua, Bash, SQL,
              Nix, Java
            </p>
          </div>
          <div>
            <h3 class="text-lg font-semibold">Frameworks & Libraries</h3>
            <p>PyTorch, OpenCV, Astro, React, Angular, Express.js</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold">Tools & Platforms</h3>
            <p>
              Docker, Kubernetes (K8s), Terraform, Git, Nix/NixOS, Maturin, MPI,
              HDF5, AWS, Django, PostgreSQL, MySQL, Oracle SQL
            </p>
          </div>
          <div>
            <h3 class="text-lg font-semibold">Concepts</h3>
            <p>Machine Learning, RL/MARL</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold">Software Engineering</h3>
            <p>SOLID, Agile, Scrum, CI/CD, DevOps, Parallel Programming</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold">Soft Skills</h3>
            <p>
              Team collaboration, Technical communication, Self-directed
              learning, Mentorship
            </p>
          </div>
        </div>
      </section>
    </div>
  </CenterLayout>
</BaseLayout>
